# Production environment for compose.prod.yml.
#   cp .env.production.example .env.production   # then fill in every value
#   make prod-up && make prod-migrate
# Read by both `docker compose --env-file` (for ${DOMAIN} etc. in the compose
# file) and by the api/worker containers (env_file). Never commit it.

# --- Domain / TLS (Caddy) ---
# DNS A/AAAA record for DOMAIN must point at this server; ports 80 and 443
# must be reachable from the internet for Let's Encrypt. Use DOMAIN=localhost
# for a local smoke test (self-signed via Caddy's internal CA).
DOMAIN=jobs.example.com
ACME_EMAIL=you@example.com

# --- Postgres ---
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=generate-a-strong-password
POSTGRES_DB=job_agent
# Keep user/password/db in sync with the three values above.
DATABASE_URL=postgresql://job_agent:generate-a-strong-password@postgres:5432/job_agent?connection_limit=10&pool_timeout=10&connect_timeout=10

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# `openssl rand -hex 32`. Placeholder-looking values are refused at startup.
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Hardening ---
# production => /docs off, HSTS on, https-only CORS enforced, infra details
# hidden from /health.
ENVIRONMENT=production
# Exactly the site origin (https://DOMAIN). "*" and http:// are refused.
CORS_ORIGINS=https://jobs.example.com
# Which proxy uvicorn trusts for X-Forwarded-For. The API port is not published
# on the host and Caddy is the only hop on the compose network, so "*" is safe
# here; if you put another proxy in front of Caddy, list its IP instead.
FORWARDED_ALLOW_IPS=*
AI_RATE_LIMIT_PER_MINUTE=30
SEARCH_RATE_LIMIT_PER_MINUTE=5
MAX_REQUEST_BODY_BYTES=1048576

# --- AI ---
# If LLM_API_KEY is empty the app silently falls back to the mock provider —
# double-check this before going live.
LLM_PROVIDER=api
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite

# --- Daily agent ---
# 08:00 Asia/Kolkata = 02:30 UTC cron in the worker; digest follows the run.
DAILY_SEARCH_TIME=08:00
TIMEZONE=Asia/Kolkata
MAX_DAILY_RESULTS=10
MIN_MATCH_SCORE=60

# --- Notifications ---
# Telegram delivers the daily digest once the user saves their chat ID and
# enables the channel in Settings (see .env.example for the BotFather steps).
TELEGRAM_NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=
EMAIL_NOTIFICATIONS_ENABLED=false
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM_ADDRESS=

# --- Resumes ---
# Inside the container; backed by the resume_data volume (see make prod-backup).
RESUME_STORAGE_DIR=data/resumes
RESUME_MAX_UPLOAD_MB=5

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
