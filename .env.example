# Copy this file to .env and fill in real values before running docker compose.

# --- Postgres ---
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=job_agent
# Host-side port only. Change it if something else on your machine already
# listens there (another project's Postgres, a local install, etc.).
POSTGRES_PORT=5432

# Used by the api/worker containers over the Docker network (service name "postgres").
# Prisma CLI commands (generate/migrate) are also run inside the api container
# via `make prisma-migrate`, so they read this same value.
# connection_limit caps the Prisma pool PER PROCESS (api + worker + every
# uvicorn worker each open their own); Postgres 16 defaults to max_connections=100.
DATABASE_URL=postgresql://job_agent:changeme@postgres:5432/job_agent?connection_limit=10&pool_timeout=10&connect_timeout=10
# Optional: for connecting a host-side DB client (psql, TablePlus, Prisma Studio
# run from your machine) to the Postgres port exposed on localhost. Not used by
# the apps themselves.
DATABASE_URL_LOCAL=postgresql://job_agent:changeme@localhost:5432/job_agent

# --- Redis ---
# Host-side port only. Change it if something else already listens there.
REDIS_PORT=6379
# Used by the api/worker containers over the Docker network (service name "redis")
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Signing key for JWTs (min 32 chars; placeholder values are refused when
# ENVIRONMENT=production). Generate a real one: `openssl rand -hex 32`
JWT_SECRET=change-me-generate-a-long-random-string-0123456789

# --- Hardening ---
# ENVIRONMENT=production disables /docs, requires https CORS origins, enables
# HSTS and hides infrastructure error details from /health.
# ENVIRONMENT=development
# Per-IP budget shared by every LLM-backed route (analyze, match, resume
# analysis, gap analysis, digest preview).
AI_RATE_LIMIT_PER_MINUTE=30
# JSON request bodies above this are rejected with 413 (uploads use RESUME_MAX_UPLOAD_MB).
MAX_REQUEST_BODY_BYTES=1048576
# Reverse-proxy addresses whose X-Forwarded-For uvicorn trusts (comma-separated,
# or "*" behind a trusted ingress only). Without it every client behind the
# proxy shares one rate-limit bucket.
FORWARDED_ALLOW_IPS=127.0.0.1
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Daily agent ---
# When the scheduled daily search runs, in TIMEZONE (HH:MM).
DAILY_SEARCH_TIME=08:00
TIMEZONE=Asia/Kolkata
# Per-source cap for discovery is DISCOVERY_MAX_JOBS_PER_SOURCE (default 50).
MAX_DAILY_RESULTS=10
MIN_MATCH_SCORE=60

# --- Analytics ---
# Match score at/above which a job counts as "relevant" on /analytics, and the
# number of rows in the company performance table.
ANALYTICS_RELEVANT_MIN_SCORE=75
ANALYTICS_COMPANY_LIMIT=10

# --- Notifications ---
# In-app (bell) notifications are always on. Email/Telegram send only when
# the flag below is true AND the credentials are set AND the user enabled the
# channel in their settings.
EMAIL_NOTIFICATIONS_ENABLED=false
#SMTP_HOST=
#SMTP_PORT=587
#SMTP_USERNAME=
#SMTP_PASSWORD=
#SMTP_FROM_ADDRESS=
TELEGRAM_NOTIFICATIONS_ENABLED=false
#TELEGRAM_BOT_TOKEN=

# --- AI ---
# "mock" (default, no key needed) or "openai" (requires OPENAI_API_KEY).
LLM_PROVIDER=mock
#OPENAI_API_KEY=
#OPENAI_MODEL=gpt-4o-mini

# --- Resumes (Phase 14) ---
# Uploaded originals are stored here (a named volume in docker-compose);
# extracted text is kept in Postgres. PDF/DOCX only.
RESUME_STORAGE_DIR=data/resumes
RESUME_MAX_UPLOAD_MB=5

# --- API ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
# Comma-separated list of origins allowed to call the API from a browser.
# Must include the frontend dev server (job_agent_frontend runs on 5173).
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000
