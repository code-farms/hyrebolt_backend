# Copy this file to .env and fill in real values before running docker compose.

# --- Postgres ---
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=changeme
POSTGRES_DB=job_agent
# Host-side port only. Change it if something else on your machine already
# listens there (another project's Postgres, a local install, etc.).
POSTGRES_PORT=5432

# Used by the api/worker containers over the Docker network (service name "postgres").
# Prisma CLI commands (generate/migrate) are also run inside the api container
# via `make prisma-migrate`, so they read this same value.
DATABASE_URL=postgresql://job_agent:changeme@postgres:5432/job_agent
# Optional: for connecting a host-side DB client (psql, TablePlus, Prisma Studio
# run from your machine) to the Postgres port exposed on localhost. Not used by
# the apps themselves.
DATABASE_URL_LOCAL=postgresql://job_agent:changeme@localhost:5432/job_agent

# --- Redis ---
# Host-side port only. Change it if something else already listens there.
REDIS_PORT=6379
# Used by the api/worker containers over the Docker network (service name "redis")
REDIS_URL=redis://redis:6379/0

# --- Auth ---
# Signing key for JWTs. Generate a real one: `openssl rand -hex 32`
JWT_SECRET=change-me-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- API ---
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console
# Comma-separated list of origins allowed to call the API from a browser.
# Must include the frontend dev server (job_agent_frontend runs on 5173).
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000
